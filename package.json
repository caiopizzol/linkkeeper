{
  "name": "linkkeeper",
  "version": "0.1.0",
  "private": true,
  "description": "Permanent URLs for things that move",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun run src/cli.ts build",
    "check": "bun run src/cli.ts check",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2"
  }
}
